# oh-my-zsh settings
export ZSH="$HOME/.oh-my-zsh"
plugins=(fzf fzf-tab gcloud vi-mode)
source $ZSH/oh-my-zsh.sh

export EDITOR='nvim'
export GIT_EDITOR='nvim'

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --strip-cwd-prefix'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="--tmux 90% --bind 'ctrl-h:reload(fd --type f --hidden --no-ignore --exclude .git --strip-cwd-prefix)+change-prompt(All> )'"

export VI_MODE_SET_CURSOR=true

alias c=pbcopy
alias python=python3
alias lg=lazygit
alias ta="tmux attach"
alias ls="eza -lh"
alias ccd="claude --dangerously-skip-permissions"
alias cdd="codex --dangerously-bypass-approvals-and-sandbox"
alias ccs="ccsession --exclude-reviewer --since 14d -- --dangerously-skip-permissions"
alias cs="cswap"
alias dlm="yt-dlp -x --audio-format mp3"
alias ghf='cd $(ghq root)/$(ghq list | fzf)'
alias u=unleash

# Yazi shell wrapper - cd to directory on exit
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

export PATH="$PATH:$HOME/bin:$HOME/.local/bin"

# Add Go binaries to PATH.
export GOPATH=$HOME/go
export PATH="$GOPATH/bin:$PATH"

